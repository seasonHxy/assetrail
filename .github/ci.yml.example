name: AssetRail
on: [push, pull_request]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true
      - uses: foundry-rs/foundry-toolchain@v1
        with:
          version: v1.8.1
      - run: test -z "$(gofmt -l .)"
      - run: go vet ./...
      - run: go test -race ./...
      - run: forge fmt --root contracts --check
      - run: forge test --root contracts -vv
      - run: make assetrail-demo
      - run: go run ./cmd/demo -json
      - run: make smoke
      - run: make smoke-network
      - run: make smoke-bft
      - run: make evidence
      - run: make consensus-demo
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: assetrail-evidence
          path: |
            reports/assetrail/
            reports/evidence/
            reports/consensus/
            reports/bft/
